# Copy this file to .env (never commit .env). Real environment variables override these values.

# Required when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# development (default) or production (disables debug, requires SECRET_KEY, HTTPS-only cookies)
APP_ENV=development

# --- AI Mock Interview (optional) ---
# Leave LLM_API_KEY empty to use the clearly labelled fallback mode (no AI calls are made).
LLM_API_KEY=
# anthropic or openai (openai also works with any OpenAI-compatible API via LLM_BASE_URL)
LLM_PROVIDER=anthropic
# Optional: empty uses the provider default
LLM_MODEL=
LLM_BASE_URL=
# Safety limits
LLM_TIMEOUT=20
LLM_MAX_OUTPUT_TOKENS=600
LLM_DAILY_LIMIT_PER_USER=30
